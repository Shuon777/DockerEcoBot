# --- Модели ---
# Какие исполнители загружать (порядок = порядок выполнения). gigachat — платный, добавляйте по необходимости
ANNOTATOR_EXECUTORS=clip,grounding_dino,owlv2,phenovision
# Вес голоса каждой модели в итоговом вердикте
EXECUTOR_WEIGHTS=clip=1.0,grounding_dino=0.8,owlv2=0.8,phenovision=2.0,gigachat=1.2
# Ниже порога итог «не определено»
CONFIDENCE_THRESHOLD=0.4
DETECTION_THRESHOLD=0.1
ENABLE_CAPTION=true
DEVICE=auto
MODELS_DIR=/app/models
# Можно указать уже скачанные веса из images-extractor, например:
# OWLV2_PATH=/app/models/local_owlv2_model

# --- Доступ ---
# Тот же токен прописать в AdminPanel/.env как ANNOTATOR_TOKEN
ANNOTATOR_API_TOKEN=change-me
# Для относительных путей картинок (/images/...) внутри docker-сети
IMAGE_BASE_URL=http://nginx
# Ссылки вида http://localhost/images/... внутри контейнера не работают — отправляем их в nginx
# На сервере добавьте через запятую публичный адрес сайта, чтобы фото с /images/ брались напрямую из nginx:
# IMAGE_URL_REWRITE=http://localhost=http://nginx,https://ecoassistant.194-156-118-21.sslip.io=http://nginx
IMAGE_URL_REWRITE=http://localhost=http://nginx
IMAGE_TIMEOUT_SEC=60

# --- GigaChat (опционально) ---
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Если старые адреса Сбера недоступны: GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat-Pro
