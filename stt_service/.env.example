# Настройки STT-сервиса

STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# 0 — по числу доступных ядер
STT_CPU_THREADS=0
STT_MODEL_CACHE_DIR=/models/whisper
STT_LANGUAGE=ru

# Словарь
STT_WORDS=Байкал, нерпа, эдельвейс
STT_WORDS_FILE=/app/data/words.txt

# Ограничение на размер загружаемого файла, МБ
STT_MAX_UPLOAD_MB=25

# Уровень логирования: DEBUG, INFO, WARNING
STT_LOG_LEVEL=INFO
